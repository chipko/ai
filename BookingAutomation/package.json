{
  "name": "booking-automation",
  "private": true,
  "description": "CSV-driven Playwright automation for making bookings on HealthHub",
  "scripts": {
    "test": "playwright test",
    "test:mock": "cross-env BOOKING_CONFIG=configs/mock.config.ts playwright test",
    "test:headed": "playwright test --headed",
    "record": "playwright codegen",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.5.6"
  }
}
